# Language
LANGUAGES=en

# Dataset
INGEST_SAMPLE_SIZE=10000

# Embeddings
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=vaani_rag

# Groq
GROQ_API_KEY=
LLM_MODEL=llama-3.1-70b-versatile
MAX_CONTEXT_TOKENS=1500
MAX_OUTPUT_TOKENS=256

# Sarvam
SARVAM_API_KEY=

# Chunking
CHUNK_SIZE_MIN=300
CHUNK_SIZE_MAX=500
CHUNK_OVERLAP=75

# Retrieval
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
LEXICAL_METHOD=bm25
SUFFICIENCY_THRESHOLD=0.35

# Optional features
ENABLE_RERANKER=true
ENABLE_QUERY_EXPANSION=false

# Cache
CACHE_TTL_SECONDS=300

# Direct MSMARCO-XI Parquet source (English fields are embedded in each language file)
MSMARCO_XI_FILE=validation/urdval.parquet
MSMARCO_XI_FILE_BYTES=419206311
CURL_BIN=curl


# Health uses a short SDK timeout; ingestion uses this longer timeout
QDRANT_TIMEOUT_MS=120000
QDRANT_BATCH_SIZE=128


# Destructive development-only reset; normal ingestion remains non-destructive
RESET_QDRANT_COLLECTION=false


